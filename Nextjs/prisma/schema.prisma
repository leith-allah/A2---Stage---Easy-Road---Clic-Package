generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model achat_package {
  id_achat_pack           BigInt         @id @default(autoincrement())
  ref_achat_pack          String         @unique @db.VarChar(255)
  nb_voyageurs            Int            @db.SmallInt
  classe_vol_achat_pack   String         @db.VarChar(50)
  type_chambre_achat_pack String         @db.VarChar(50)
  pension_achat_pack      String         @db.VarChar(50)
  prix_achat_pack         Decimal        @db.Decimal(10, 2)
  remise_achat_pack       Decimal?       @default(0) @db.Decimal(5, 2)
  total_achat_pack        Decimal        @db.Decimal(10, 2)
  date_heure_achat_pack   DateTime       @db.Timestamp(6)
  statut_achat_pack       String         @db.VarChar(50)
  id_transac              BigInt?        @unique
  id_pack                 BigInt
  id_user                 BigInt
  package_voyage          package_voyage @relation(fields: [id_pack], references: [id_pack], onUpdate: NoAction)
  transactions            transactions?  @relation(fields: [id_transac], references: [id_transac], onDelete: Restrict, onUpdate: NoAction)
  utilisateur             utilisateur    @relation(fields: [id_user], references: [id_user], onUpdate: NoAction)

  @@index([id_pack], map: "idx_achat_pack")
  @@index([id_user], map: "idx_achat_user")
}

model agence {
  id_agence     BigInt          @id @default(autoincrement())
  mle_agence    String          @unique @db.VarChar(255)
  nom_agence    String          @db.VarChar(50)
  dc_agence     DateTime        @db.Date
  sj_agence     String          @db.VarChar(30)
  bureau_agence bureau_agence[]
}

model bureau_agence {
  id_bureau               BigInt                    @id @default(autoincrement())
  mle_bureau              String                    @unique @db.VarChar(255)
  type_bureau             String                    @db.VarChar(50)
  dc_bureau               DateTime                  @db.Date
  pays_bureau             String                    @db.VarChar(50)
  ville_bureau            String                    @db.VarChar(50)
  adresse_bureau          String                    @db.VarChar(255)
  num_agr_bureau          String                    @unique @db.VarChar(50)
  rib_agence              String?                   @db.VarChar(30)
  iban_agence             String?                   @db.VarChar(34)
  dcc_bureau              DateTime                  @db.Date
  id_agence               BigInt
  agence                  agence                    @relation(fields: [id_agence], references: [id_agence], onDelete: Cascade, onUpdate: NoAction)
  demande_creation_compte demande_creation_compte[]
  utilisateur             utilisateur[]
}

model demande_rechargement {
  id_demande_recharge         BigInt        @id @default(autoincrement())
  statut_demande_recharge     String        @db.VarChar(50)
  montant_demande_recharge    Decimal       @db.Decimal(10, 2)
  date_heure_demande_recharge DateTime      @db.Timestamp(6)
  comment_demande_recharge    String?
  id_user                     BigInt
  utilisateur                 utilisateur   @relation(fields: [id_user], references: [id_user], onUpdate: NoAction)
  transactions                transactions?
}

model excursion {
  id_exc          BigInt    @id @default(autoincrement())
  nom_exc         String    @db.VarChar(255)
  lieu_exc        String    @db.VarChar(50)
  description_exc String
  propose         propose[]
}

model favorise {
  id_user        BigInt
  id_pack        BigInt
  date_ajout_fav DateTime       @db.Timestamp(6)
  package_voyage package_voyage @relation(fields: [id_pack], references: [id_pack], onDelete: Cascade, onUpdate: NoAction)
  utilisateur    utilisateur    @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction)

  @@id([id_user, id_pack])
}

model heberge {
  id_hot         BigInt
  id_pack        BigInt
  hotel          hotel          @relation(fields: [id_hot], references: [id_hot], onDelete: Cascade, onUpdate: NoAction)
  package_voyage package_voyage @relation(fields: [id_pack], references: [id_pack], onDelete: Cascade, onUpdate: NoAction)

  @@id([id_hot, id_pack])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model hotel {
  id_hot         BigInt    @id @default(autoincrement())
  nom_hot        String    @db.VarChar(100)
  nb_etoiles_hot Int       @db.SmallInt
  pays_hot       String    @db.VarChar(50)
  ville_hot      String    @db.VarChar(50)
  adresse_hot    String    @db.VarChar(255)
  heberge        heberge[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model package_voyage {
  id_pack                   BigInt          @id @default(autoincrement())
  mle_pack                  String          @unique @db.VarChar(255)
  statut_pack               String          @db.VarChar(100)
  nom_pack                  String          @db.VarChar(255)
  pays_pack                 String          @db.VarChar(50)
  destination_pack          String          @db.VarChar(50)
  image_pack                String?         @db.VarChar(255)
  description_pack          String?
  date_depart_pack          DateTime        @db.Date
  date_retour_pack          DateTime        @db.Date
  prix_base_pack            Decimal         @db.Decimal(10, 2)
  stock_total_pack          Int
  stock_dispo_pack          Int
  date_heure_creation_pack  DateTime        @db.Timestamp(6)
  supp_economy_pack         Decimal?        @default(0) @db.Decimal(10, 2)
  supp_business_pack        Decimal?        @default(0) @db.Decimal(10, 2)
  supp_first_pack           Decimal?        @default(0) @db.Decimal(10, 2)
  supp_single_pack          Decimal?        @default(0) @db.Decimal(10, 2)
  supp_double_pack          Decimal?        @default(0) @db.Decimal(10, 2)
  supp_triple_pack          Decimal?        @default(0) @db.Decimal(10, 2)
  supp_quadruple_pack       Decimal?        @default(0) @db.Decimal(10, 2)
  supp_suite_pack           Decimal?        @default(0) @db.Decimal(10, 2)
  supp_bed_only_pack        Decimal?        @default(0) @db.Decimal(10, 2)
  supp_bed_breakfast_pack   Decimal?        @default(0) @db.Decimal(10, 2)
  supp_half_board_pack      Decimal?        @default(0) @db.Decimal(10, 2)
  supp_full_board_pack      Decimal?        @default(0) @db.Decimal(10, 2)
  supp_all_inclusive_pack   Decimal?        @default(0) @db.Decimal(10, 2)
  default_flight_class_pack String          @db.VarChar(50)
  default_room_type_pack    String          @db.VarChar(50)
  default_board_type_pack   String          @db.VarChar(50)
  id_user                   BigInt
  achat_package             achat_package[]
  favorise                  favorise[]
  heberge                   heberge[]
  utilisateur               utilisateur     @relation(fields: [id_user], references: [id_user], onUpdate: NoAction)
  possede                   possede[]
  propose                   propose[]
  utilise                   utilise[]

  @@index([destination_pack], map: "idx_package_destination")
  @@index([statut_pack], map: "idx_package_statut")
  @@index([id_user], map: "idx_package_owner")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model portefeuille {
  id_prtfl                                                       BigInt         @id @default(autoincrement())
  num_prtfl                                                      String         @unique @db.VarChar(255)
  solde_total_prtfl                                              Decimal        @default(0) @db.Decimal(10, 2)
  derniere_maj_prtfl                                             DateTime       @db.Timestamp(6)
  id_user                                                        BigInt         @unique
  utilisateur                                                    utilisateur    @relation(fields: [id_user], references: [id_user], onDelete: Cascade, onUpdate: NoAction)
  transactions_transactions_id_portefeuille_destToportefeuille   transactions[] @relation("transactions_id_portefeuille_destToportefeuille")
  transactions_transactions_id_portefeuille_sourceToportefeuille transactions[] @relation("transactions_id_portefeuille_sourceToportefeuille")
}

model possede {
  id_vol         BigInt
  id_pack        BigInt
  ordre          Int            @db.SmallInt
  package_voyage package_voyage @relation(fields: [id_pack], references: [id_pack], onDelete: Cascade, onUpdate: NoAction)
  vol            vol            @relation(fields: [id_vol], references: [id_vol], onDelete: Cascade, onUpdate: NoAction)

  @@id([id_vol, id_pack])
}

model propose {
  id_exc         BigInt
  id_pack        BigInt
  excursion      excursion      @relation(fields: [id_exc], references: [id_exc], onDelete: Cascade, onUpdate: NoAction)
  package_voyage package_voyage @relation(fields: [id_pack], references: [id_pack], onDelete: Cascade, onUpdate: NoAction)

  @@id([id_exc, id_pack])
}

model role {
  id_role                 BigInt                    @id @default(autoincrement())
  nom_role                String                    @unique @db.VarChar(100)
  demande_creation_compte demande_creation_compte[]
  utilisateur             utilisateur[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transactions {
  id_transac                                                     BigInt                @id @default(autoincrement())
  ref_transac                                                    String                @unique @db.VarChar(255)
  type_transac                                                   String                @db.VarChar(50)
  statut_transac                                                 String                @db.VarChar(50)
  montant_transac                                                Decimal               @db.Decimal(10, 2)
  description_transac                                            String?
  date_heure_transac                                             DateTime              @db.Timestamp(6)
  id_demande_recharge                                            BigInt?               @unique
  id_user                                                        BigInt?
  id_portefeuille_source                                         BigInt
  id_portefeuille_dest                                           BigInt
  achat_package                                                  achat_package?
  demande_rechargement                                           demande_rechargement? @relation(fields: [id_demande_recharge], references: [id_demande_recharge], onDelete: Restrict, onUpdate: NoAction)
  portefeuille_transactions_id_portefeuille_destToportefeuille   portefeuille          @relation("transactions_id_portefeuille_destToportefeuille", fields: [id_portefeuille_dest], references: [id_prtfl], onUpdate: NoAction)
  portefeuille_transactions_id_portefeuille_sourceToportefeuille portefeuille          @relation("transactions_id_portefeuille_sourceToportefeuille", fields: [id_portefeuille_source], references: [id_prtfl], onUpdate: NoAction)
  utilisateur                                                    utilisateur?          @relation(fields: [id_user], references: [id_user], onDelete: Restrict, onUpdate: NoAction)

  @@index([id_portefeuille_dest], map: "idx_trans_port_dest")
  @@index([id_portefeuille_source], map: "idx_trans_port_src")
  @@index([id_user], map: "idx_trans_user")
}

model transport {
  id_transp      BigInt    @id @default(autoincrement())
  trajet_transp  String    @db.VarChar(50)
  societe_transp String?   @db.VarChar(50)
  utilise        utilise[]
}

model utilisateur {
  id_user                 BigInt                    @id @default(autoincrement())
  mle_user                String                    @unique @db.VarChar(255)
  nin_user                String                    @unique @db.VarChar(30)
  nom_user                String                    @db.VarChar(50)
  prenom_user             String                    @db.VarChar(50)
  ddn_user                DateTime                  @db.Date
  nat_user                String                    @db.VarChar(50)
  statut_user             String                    @db.VarChar(50)
  email_pro_user          String                    @unique @db.VarChar(50)
  mdp_user                String
  dcc_user                DateTime                  @db.Date
  id_role                 BigInt
  id_bureau               BigInt
  achat_package           achat_package[]
  demande_creation_compte demande_creation_compte[]
  demande_rechargement    demande_rechargement[]
  favorise                favorise[]
  package_voyage          package_voyage[]
  portefeuille            portefeuille?
  transactions            transactions[]
  bureau_agence           bureau_agence             @relation(fields: [id_bureau], references: [id_bureau], onDelete: NoAction, onUpdate: NoAction)
  role                    role                      @relation(fields: [id_role], references: [id_role], onDelete: NoAction, onUpdate: NoAction)

  @@index([id_bureau], map: "idx_user_bureau")
  @@index([id_role], map: "idx_user_role")
}

model utilise {
  id_transp      BigInt
  id_pack        BigInt
  package_voyage package_voyage @relation(fields: [id_pack], references: [id_pack], onDelete: Cascade, onUpdate: NoAction)
  transport      transport      @relation(fields: [id_transp], references: [id_transp], onDelete: Cascade, onUpdate: NoAction)

  @@id([id_transp, id_pack])
}

model vol {
  id_vol                                     BigInt             @id @default(autoincrement())
  statut_vol                                 String             @default("ACTIVE") @db.VarChar(50)
  num_vol                                    String             @db.VarChar(10)
  depart_vol                                 DateTime           @db.Timestamp(6)
  arrivee_vol                                DateTime           @db.Timestamp(6)
  id_aeroport_depart                         Int                @db.SmallInt
  id_aeroport_arrivee                        Int                @db.SmallInt
  id_compagnie                               Int                @db.SmallInt
  possede                                    possede[]
  aeroport_vol_id_aeroport_arriveeToaeroport aeroport           @relation("vol_id_aeroport_arriveeToaeroport", fields: [id_aeroport_arrivee], references: [id_aeroport], onUpdate: NoAction)
  aeroport_vol_id_aeroport_departToaeroport  aeroport           @relation("vol_id_aeroport_departToaeroport", fields: [id_aeroport_depart], references: [id_aeroport], onUpdate: NoAction)
  compagnie_aerienne                         compagnie_aerienne @relation(fields: [id_compagnie], references: [id_compagnie], onUpdate: NoAction)

  @@unique([num_vol, depart_vol])
  @@index([id_aeroport_arrivee], map: "idx_vol_arrivee")
  @@index([id_compagnie], map: "idx_vol_compagnie")
  @@index([depart_vol], map: "idx_vol_datetime")
  @@index([id_aeroport_depart], map: "idx_vol_depart")
}

model demande_creation_compte {
  id_demande_creation     BigInt        @id @default(autoincrement())
  statut_demande_creation String        @db.VarChar(50)
  nom_user                String        @db.VarChar(50)
  prenom_user             String        @db.VarChar(50)
  ddn_user                DateTime      @db.Date
  nat_user                String        @db.VarChar(50)
  nin_user                String        @db.VarChar(30)
  email_user              String        @db.VarChar(100)
  mdp_user                String
  commentaire_demande     String?
  date_heure_demande      DateTime      @default(now()) @db.Timestamp(6)
  id_role                 BigInt
  id_bureau               BigInt
  traite_par              BigInt?
  date_traitement         DateTime?     @db.Timestamp(6)
  bureau_agence           bureau_agence @relation(fields: [id_bureau], references: [id_bureau], onDelete: NoAction, onUpdate: NoAction)
  role                    role          @relation(fields: [id_role], references: [id_role], onDelete: NoAction, onUpdate: NoAction)
  utilisateur             utilisateur?  @relation(fields: [traite_par], references: [id_user], onDelete: NoAction, onUpdate: NoAction)

  @@index([statut_demande_creation], map: "idx_demande_creation_statut")
  @@index([id_bureau], map: "idx_demande_creation_bureau")
  @@index([id_role], map: "idx_demande_creation_role")
}

model aeroport {
  id_aeroport                           Int    @id @db.SmallInt
  code_iata_aeroport                    String @unique @db.Char(3)
  code_icao_aeroport                    String @unique @db.Char(4)
  nom_aeroport                          String @db.VarChar(150)
  latitude_aeroport                     Float
  longitude_aeroport                    Float
  id_ville                              Int
  ville                                 ville  @relation(fields: [id_ville], references: [id_ville], onUpdate: NoAction)
  vol_vol_id_aeroport_arriveeToaeroport vol[]  @relation("vol_id_aeroport_arriveeToaeroport")
  vol_vol_id_aeroport_departToaeroport  vol[]  @relation("vol_id_aeroport_departToaeroport")

  @@unique([nom_aeroport, id_ville])
  @@index([id_ville], map: "idx_aeroport_ville")
}

model compagnie_aerienne {
  id_compagnie        Int     @id @db.SmallInt
  code_iata_compagnie String  @unique @db.Char(2)
  code_icao_compagnie String  @unique @db.Char(4)
  nom_compagnie       String  @unique @db.VarChar(100)
  site_compagnie      String? @db.VarChar(255)
  vol                 vol[]
}

model pays {
  id_pays            Int     @id @db.SmallInt
  code_iso2_pays     String  @unique @db.Char(2)
  code_iso3_pays     String  @unique @db.Char(3)
  nom_pays           String  @unique @db.VarChar(100)
  indicatif_tel_pays String  @db.VarChar(10)
  ville              ville[]
}

model ville {
  id_ville             Int        @id
  code_iata_ville      String?    @db.Char(3)
  nom_ville            String     @db.VarChar(100)
  latitude_ville       Float
  longitude_ville      Float
  fuseau_horaire_ville String     @db.VarChar(50)
  id_pays              Int        @db.SmallInt
  aeroport             aeroport[]
  pays                 pays       @relation(fields: [id_pays], references: [id_pays], onUpdate: NoAction)

  @@index([id_pays], map: "idx_ville_pays")
}
